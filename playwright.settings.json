{
  "testDir": "./tests",
  "outputDir": "reports/{reportId}/test-results",
  "fullyParallel": true,
  "workers": 4,
  "timeout": 30000,
  "expect": {
    "timeout": 5000
  },
  "reporter": [
    ["list"],
    [
      "html",
      {
        "outputFolder": "reports/{reportId}/html",
        "open": "never"
      }
    ]
  ],
  "use": {
    "baseURL": "https://app.canary.talkspace.com",
    "headless": false,
    "viewport": null,
    "testIdAttribute": "data-qa",
    "trace": "retain-on-failure",
    "screenshot": "only-on-failure",
    "launchOptions": {
      "slowMo": 5000,
      "args": ["--start-maximized"]
    }
  },
  "projects": [
    {
      "name": "chromium",
      "use": {
        "browserName": "chromium",
        "viewport": null
      }
    }
  ]
}
